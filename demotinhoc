                                    <div class="flex flex-wrap items-center gap-2">
                                        ${kwPillHtml}
                                        <span class="px-2 py-0.5 rounded bg-slate-200 dark:bg-slate-800 font-mono font-bold text-[11px]">
                                            Chốt: ${sub.answer ? 'ĐÚNG' : 'SAI'}
                                        </span>
                                    </div>
                                    <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
                                        <strong class="text-amber-700 dark:text-amber-400"><i class="fa-solid fa-lightbulb mr-1"></i>Giải thích dễ hiểu:</strong> ${sub.easyExplain}
                                    </p>
                                </div>
                            ` : ''}
                        </div>
                    `;
                }).join('');

                const badgeType = qObj.isOriginal
                    ? `<span class="px-2.5 py-1 rounded-lg bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 text-xs font-bold">Câu Gốc Đề Cương</span>`
                    : `<span class="px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-500/40 text-xs font-extrabold"><i class="fa-solid fa-wand-magic-sparkles mr-1"></i>Câu Sinh Mới (Đề Lạ)</span>`;

                return `
                    <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-md border border-slate-200 dark:border-slate-800 p-4 sm:p-6 space-y-4">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="px-3 py-1 rounded-lg bg-indigo-600 text-white font-mono font-extrabold text-xs sm:text-sm">
                                    Câu Đúng/Sai #${idx + 1}
                                </span>
                                ${badgeType}
                                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
                                    ${qObj.topicName}
                                </span>
                            </div>
                        </div>

                        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/90 border-l-4 border-indigo-500 text-slate-800 dark:text-slate-200 text-sm leading-relaxed">
                            ${qObj.passage}
                        </div>

                        <div class="space-y-3">
                            ${subHtml}
                        </div>
                    </div>
                `;
            }).join('');
        }

        /**************************************************************************
         * 4. QUẢN LÝ TRẠNG THÁI BÀI THI TỔNG HỢP (PHẦN I + PHẦN II)
         **************************************************************************/
        let currentMode = 'standard'; // 'standard' | 'full' | 'onlyp2' | 'custom'
        let examState = {
            isActive: false,
            isSubmitted: false,
            examCode: 'IT2026',
            durationMinutes: 40,
            remainingSeconds: 2400,
            elapsedSeconds: 0,
            timerInterval: null,
            showBoldHint: false,
            showTipsLive: false,
            part1Questions: [],
            part2Questions: [],
            answersP1: {},
            answersP2: {},
            flaggedP1: {},
            flaggedP2: {},
            reviewFilter: 'all'
        };

        function generateRandomExamCode() {
            return 'IT' + String(Math.floor(1000 + Math.random() * 9000));
        }

        function selectExamMode(mode) {
            currentMode = mode;
            const cards = {
                standard: document.getElementById('modeCardStandard'),
                full: document.getElementById('modeCardFull'),
                onlyp2: document.getElementById('modeCardOnlyP2'),
                custom: document.getElementById('modeCardCustom')
            };
            const activeStyle = "cursor-pointer rounded-2xl border-2 border-cyan-500 bg-cyan-50/50 dark:bg-cyan-950/20 p-4 transition flex flex-col justify-between gap-2";
            const inactiveStyle = "cursor-pointer rounded-2xl border-2 border-slate-200 dark:border-slate-700 hover:border-cyan-400 p-4 transition flex flex-col justify-between gap-2";

            Object.keys(cards).forEach(k => {
                cards[k].className = (k === mode) ? activeStyle : inactiveStyle;
                cards[k].querySelector('input').checked = (k === mode);
            });

            const customControls = document.getElementById('customCountControls');
            if (mode === 'custom') {
                customControls.classList.remove('hidden');
                customControls.classList.add('grid');
                updateAvailableCounts();
            } else {
                customControls.classList.add('hidden');
                customControls.classList.remove('grid');
            }
        }

        function getSelectedTopics() {
            const cbs = document.querySelectorAll('.topic-cb:checked');
            return Array.from(cbs).map(cb => cb.value);
        }

        function toggleAllTopics() {
            const allCbs = document.querySelectorAll('.topic-cb');
            const allChecked = Array.from(allCbs).every(cb => cb.checked);
            allCbs.forEach(cb => cb.checked = !allChecked);
            updateAvailableCounts();
        }

        function updateAvailableCounts() {
            const topics = getSelectedTopics();
            const availP1 = CS_QUESTION_BANK.part1.filter(q => topics.includes(q.topic)).length;
            const availP2 = CS_QUESTION_BANK.part2.filter(q => topics.includes(q.topic)).length;

            document.getElementById('maxP1Label').textContent = availP1;
            document.getElementById('maxP2Label').textContent = availP2;
        }

        function setDuration(minutes) {
            document.getElementById('durationInput').value = minutes;
            document.querySelectorAll('.time-preset').forEach(btn => {
                if (btn.textContent.startsWith(minutes + 'p')) {
                    btn.className = "time-preset px-3 py-1.5 rounded-xl text-xs font-bold border-2 border-cyan-500 bg-cyan-500/10 text-cyan-700 dark:text-cyan-300";
                } else {
                    btn.className = "time-preset px-3 py-1.5 rounded-xl text-xs font-semibold border border-slate-200 dark:border-slate-700";
                }
            });
        }

        function startExam() {
            const errorBox = document.getElementById('setupErrorBox');
            errorBox.classList.add('hidden');

            const selectedTopics = getSelectedTopics();
            if (selectedTopics.length === 0) {
                errorBox.textContent = "Vui lòng chọn ít nhất 1 chủ đề kiến thức để tạo đề kiểm tra!";
                errorBox.classList.remove('hidden');
                return;
            }

            const poolP1 = CS_QUESTION_BANK.part1.filter(q => selectedTopics.includes(q.topic));
            const poolP2 = CS_QUESTION_BANK.part2.filter(q => selectedTopics.includes(q.topic));

            let countP1 = 24, countP2Orig = 4, countP2Inf = 0;
            if (currentMode === 'standard') {
                countP1 = Math.min(24, poolP1.length);
                countP2Orig = Math.min(4, poolP2.length);
                if (countP2Orig < 4) countP2Inf = 4 - countP2Orig;
            } else if (currentMode === 'full') {
                countP1 = poolP1.length;
                countP2Orig = poolP2.length;
            } else if (currentMode === 'onlyp2') {
                countP1 = 0;
                countP2Orig = poolP2.length;
                countP2Inf = 6;
            } else {
                countP1 = Math.min(Math.max(0, parseInt(document.getElementById('customP1Input').value || 0, 10)), poolP1.length);
                countP2Orig = Math.min(Math.max(0, parseInt(document.getElementById('customP2Input').value || 0, 10)), poolP2.length);
                countP2Inf = Math.max(0, parseInt(document.getElementById('customInfiniteP2Input').value || 0, 10));
            }

            const durationMinutes = Math.max(1, parseInt(document.getElementById('durationInput').value || 40, 10));
            const doShuffle = document.getElementById('shuffleQuestionsCb').checked;
            const showBoldHint = document.getElementById('showBoldHintCb').checked;
            const showTipsLive = document.getElementById('showTipsInExamCb').checked;

            const rawP1 = (doShuffle ? shuffleArray(poolP1) : [...poolP1]).slice(0, countP1);
            const preparedP1 = rawP1.map(item => {
                const opts = [
                    { text: item.correct, isCorrect: true },
                    ...item.distractors.map(d => ({ text: d, isCorrect: false }))
                ];
                return {
                    id: item.id,
                    topic: item.topic,
                    topicName: item.topicName,
                    q: item.q,
                    options: doShuffle ? shuffleArray(opts) : opts
                };
            });

            const rawP2Orig = (doShuffle ? shuffleArray(poolP2) : [...poolP2]).slice(0, countP2Orig);
            const generatedP2 = [];
            for (let i = 0; i < countP2Inf; i++) {
                generatedP2.push(generateSingleInfiniteTFQuestion(selectedTopics));
            }

            const combinedP2 = [...rawP2Orig, ...generatedP2];
            const preparedP2 = combinedP2.map(item => {
                const subItems = item.items.map(s => ({ ...s }));
                return {
                    id: item.id,
                    isOriginal: item.isOriginal,
                    topic: item.topic,
                    topicName: item.topicName,
                    passage: item.passage,
                    items: doShuffle ? shuffleArray(subItems) : subItems
                };
            });

            if (examState.timerInterval) clearInterval(examState.timerInterval);
            examState = {
                isActive: true,
                isSubmitted: false,
                examCode: generateRandomExamCode(),
                durationMinutes,
                remainingSeconds: durationMinutes * 60,
                elapsedSeconds: 0,
                timerInterval: null,
                showBoldHint,
                showTipsLive,
                part1Questions: preparedP1,
                part2Questions: preparedP2,
                answersP1: {},
                answersP2: {},
                flaggedP1: {},
                flaggedP2: {},
                reviewFilter: 'all'
            };

            document.getElementById('setupScreen').classList.add('hidden');
            document.getElementById('infiniteTrainerScreen').classList.add('hidden');
            document.getElementById('examWorkspace').classList.remove('hidden');
            document.getElementById('resultSummaryPanel').classList.add('hidden');
            document.getElementById('examHeaderControls').classList.remove('hidden');
            document.getElementById('examHeaderControls').classList.add('flex');
            document.getElementById('backToConfigBtn').classList.remove('hidden');
            document.getElementById('backToConfigBtn').classList.add('flex');
            document.getElementById('headerSubmitBtn').classList.remove('hidden');
            document.getElementById('sidebarSubmitBtn').classList.remove('hidden');

            document.getElementById('examCodeDisplay').textContent = examState.examCode;
            document.getElementById('paperSubInfo').textContent = `Thời gian: ${durationMinutes} phút • Gồm ${preparedP1.length} câu Phần I & ${preparedP2.length} câu Phần II`;

            renderAllQuestions();
            renderQuestionPalette();
            updateProgressCounters();
            startTimer();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function appendInfiniteQuestionToActiveExam() {
            const newQ = generateSingleInfiniteTFQuestion(['NET', 'AI', 'ETHICS']);
            examState.part2Questions.push(newQ);
            renderAllQuestions();
            renderQuestionPalette();
            updateProgressCounters();
            const newIdx = examState.part2Questions.length - 1;
            const el = document.getElementById(`question_p2_${newIdx}`);
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function toggleExamTipsLive() {
            examState.showTipsLive = !examState.showTipsLive;
            renderAllQuestions();
        }

        /**************************************************************************
         * 5. HIỂN THỊ CÂU HỎI PHẦN I VÀ PHẦN II (KÈM MẸO TỪ KHÓA & GIẢI THÍCH)
         **************************************************************************/
        const OPTION_LABELS = ['A', 'B', 'C', 'D'];
        const SUB_ITEM_LABELS = ['a)', 'b)', 'c)', 'd)'];

        function renderAllQuestions() {
            const p1Wrapper = document.getElementById('part1SectionWrapper');
            const p2Wrapper = document.getElementById('part2SectionWrapper');
            const p1List = document.getElementById('part1QuestionsList');
            const p2List = document.getElementById('part2QuestionsList');

            p1List.innerHTML = '';
            p2List.innerHTML = '';

            p1Wrapper.classList.toggle('hidden', examState.part1Questions.length === 0);
            p2Wrapper.classList.toggle('hidden', examState.part2Questions.length === 0);

            const isSubmitted = examState.isSubmitted;
            const showBold = isSubmitted || examState.showBoldHint;
            const showTips = isSubmitted || examState.showTipsLive;

            // RENDER PHẦN I
            examState.part1Questions.forEach((qObj, qIndex) => {
                const userSelected = examState.answersP1[qIndex];
                const isFlagged = !!examState.flaggedP1[qIndex];
                const correctIndex = qObj.options.findIndex(o => o.isCorrect);
                const isCorrect = isSubmitted && userSelected === correctIndex;

                if (isSubmitted) {
                    if (examState.reviewFilter === 'wrong' && isCorrect) return;
                    if (examState.reviewFilter === 'flagged' && !isFlagged) return;
                }

                let statusBadge = '';
                if (isSubmitted) {
                    if (userSelected === undefined) {
                        statusBadge = `<span class="px-2.5 py-1 rounded-lg bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-bold">Chưa chọn (0đ)</span>`;
                    } else if (isCorrect) {
                        statusBadge = `<span class="px-2.5 py-1 rounded-lg bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 text-xs font-bold"><i class="fa-solid fa-check mr-1"></i>Đúng (+0,25đ)</span>`;
                    } else {
                        statusBadge = `<span class="px-2.5 py-1 rounded-lg bg-rose-500/15 text-rose-700 dark:text-rose-300 border border-rose-500/30 text-xs font-bold"><i class="fa-solid fa-xmark mr-1"></i>Sai (0đ)</span>`;
                    }
                }

                const optionsHTML = qObj.options.map((opt, optIdx) => {
                    const isThisSelected = userSelected === optIdx;
                    let btnStyle = "border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/50 hover:border-cyan-400 text-slate-700 dark:text-slate-300 font-normal";
                    let badgeStyle = "bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-600 font-medium";
                    let feedbackTag = "";

                    const isBoldAnswer = showBold && opt.isCorrect;
                    const textWeightClass = isBoldAnswer ? "correct-bold-answer" : "font-normal";
                    const badgeBoldClass = isBoldAnswer && !isSubmitted && !isThisSelected ? "correct-bold-badge" : "";

                    if (!isSubmitted) {
                        if (isThisSelected) {
                            btnStyle = "border-2 border-cyan-500 bg-cyan-50/90 dark:bg-cyan-950/40 text-slate-950 dark:text-cyan-200 shadow-xs";
                            badgeStyle = "bg-cyan-600 text-white font-extrabold border-cyan-600";
                        } else if (isBoldAnswer) {
                            btnStyle = "border-2 border-emerald-500/60 bg-emerald-50/50 dark:bg-emerald-950/20";
                        }
                    } else {
                        if (opt.isCorrect) {
                            btnStyle = "border-2 border-emerald-500 bg-emerald-50/90 dark:bg-emerald-950/35 text-emerald-950 dark:text-emerald-200";
                            badgeStyle = "bg-emerald-600 text-white font-extrabold border-emerald-600";
                            feedbackTag = `<span class="ml-auto text-xs font-mono font-extrabold text-emerald-600 dark:text-emerald-400 shrink-0"><i class="fa-solid fa-circle-check mr-1"></i>Đáp án đúng</span>`;
                        } else if (isThisSelected && !opt.isCorrect) {
                            btnStyle = "border-2 border-rose-500 bg-rose-50/80 dark:bg-rose-950/30 text-rose-950 dark:text-rose-200";
                            badgeStyle = "bg-rose-500 text-white font-extrabold border-rose-500";
                            feedbackTag = `<span class="ml-auto text-xs font-bold text-rose-600 dark:text-rose-400 shrink-0"><i class="fa-solid fa-circle-xmark mr-1"></i>Bạn chọn</span>`;
                        } else {
                            btnStyle = "border-slate-200 dark:border-slate-800 bg-slate-50/40 dark:bg-slate-900/40 opacity-65";
                        }
                    }

                    return `
                        <button type="button"
                            ${isSubmitted ? 'disabled' : `onclick="selectPart1Answer(${qIndex}, ${optIdx})"`}
                            class="w-full text-left p-3.5 rounded-xl border transition flex items-center gap-3 ${btnStyle}">
                            <span class="min-w-[2.25rem] h-8 px-1.5 rounded-lg flex items-center justify-center text-sm font-mono shrink-0 ${badgeStyle} ${badgeBoldClass} ${isBoldAnswer ? 'font-extrabold' : ''}">
                                ${OPTION_LABELS[optIdx]}.
                            </span>
                            <span class="text-sm leading-snug flex-1 ${textWeightClass}">${opt.text}</span>
                            ${feedbackTag}
                        </button>
                    `;
                }).join('');

                const card = document.createElement('div');
                card.id = `question_p1_${qIndex}`;
                card.className = `scroll-mt-24 rounded-2xl border p-4 sm:p-5 bg-white dark:bg-slate-900 transition ${
                    isSubmitted
                        ? (isCorrect ? 'border-emerald-500/40' : 'border-rose-500/40')
                        : 'border-slate-200 dark:border-slate-800'
                }`;

                card.innerHTML = `
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                        <div class="flex items-center gap-2">
                            <span class="px-3 py-1 rounded-lg bg-cyan-600 text-white font-mono font-extrabold text-xs sm:text-sm">
                                Câu ${qIndex + 1}
                            </span>
                            <span class="text-xs font-medium text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-2.5 py-1 rounded-lg">
                                ${qObj.topicName}
                            </span>
                        </div>
                        <div class="flex items-center gap-2">
                            ${statusBadge}
                            <button type="button" onclick="toggleFlag('p1', ${qIndex})"
                                class="px-2.5 py-1 rounded-lg text-xs font-semibold border transition flex items-center gap-1 ${
                                    isFlagged
                                        ? 'bg-rose-500/15 text-rose-600 dark:text-rose-400 border-rose-500/40'
                                        : 'bg-slate-100 dark:bg-slate-800 text-slate-500 border-slate-200 dark:border-slate-700 hover:text-rose-500'
                                }">
                                <i class="fa-${isFlagged ? 'solid' : 'regular'} fa-flag"></i>
                            </button>
                        </div>
                    </div>
                    <div class="font-semibold text-slate-900 dark:text-white text-sm sm:text-base mb-4 leading-relaxed">
                        ${qObj.q}
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
                        ${optionsHTML}
                    </div>
                `;
                p1List.appendChild(card);
            });

            // RENDER PHẦN II (CÓ TỪ KHÓA & GIẢI THÍCH SIÊU DỄ HIỂU)
            examState.part2Questions.forEach((qObj, qIndex) => {
                const userSubAnswers = examState.answersP2[qIndex] || {};
                const isFlagged = !!examState.flaggedP2[qIndex];

                let correctSubCount = 0;
                qObj.items.forEach((sub, sIdx) => {
                    if (userSubAnswers[sIdx] === sub.answer) correctSubCount++;
                });
                const earnedPoints = getPart2QuestionScore(correctSubCount);

                if (isSubmitted) {
                    if (examState.reviewFilter === 'wrong' && correctSubCount === 4) return;
                    if (examState.reviewFilter === 'flagged' && !isFlagged) return;
                }

                let scoreBadge = '';
                if (isSubmitted) {
                    const color = correctSubCount === 4
                        ? 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border-emerald-500/30'
                        : (correctSubCount > 0 ? 'bg-amber-500/15 text-amber-700 dark:text-amber-300 border-amber-500/30' : 'bg-rose-500/15 text-rose-700 dark:text-rose-300 border-rose-500/30');
                    scoreBadge = `
                        <span class="px-2.5 py-1 rounded-lg border text-xs font-mono font-extrabold ${color}">
                            Đúng ${correctSubCount}/4 ý (+${earnedPoints.toFixed(2).replace('.', ',')}đ)
                        </span>
                    `;
                }

                const subRowsHTML = qObj.items.map((subItem, sIdx) => {
                    const userChoice = userSubAnswers[sIdx];
                    const isSubCorrect = userChoice === subItem.answer;

                    const isBoldStatement = showBold && subItem.answer === true;
                    const statementTextClass = isBoldStatement
                        ? "correct-bold-answer"
                        : "font-normal text-slate-700 dark:text-slate-200";
                    const labelClass = isBoldStatement
                        ? "correct-bold-answer font-mono mr-1.5"
                        : "font-medium font-mono text-indigo-700 dark:text-cyan-400 mr-1.5";

                    let trueBtnClass = "border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-emerald-500";
                    let falseBtnClass = "border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:border-rose-500";
                    let resultInfoHTML = "";

                    if (!isSubmitted) {
                        if (userChoice === true) {
                            trueBtnClass = "border-2 border-emerald-600 bg-emerald-600 text-white font-extrabold shadow-xs";
                        } else if (userChoice === false) {
                            falseBtnClass = "border-2 border-rose-600 bg-rose-500 text-white font-extrabold shadow-xs";
                        }
                    } else {
                        if (userChoice === true) {
                            trueBtnClass = isSubCorrect
                                ? "border-2 border-emerald-600 bg-emerald-600 text-white font-extrabold"
                                : "border-2 border-rose-600 bg-rose-500 text-white font-extrabold";
                        } else if (userChoice === false) {
                            falseBtnClass = isSubCorrect
                                ? "border-2 border-emerald-600 bg-emerald-600 text-white font-extrabold"
                                : "border-2 border-rose-600 bg-rose-500 text-white font-extrabold";
                        }

                        const correctLabel = subItem.answer ? 'ĐÚNG (In đậm)' : 'SAI';
                        if (userChoice === undefined) {
                            resultInfoHTML = `<div class="text-xs font-bold text-rose-500 mt-1"><i class="fa-solid fa-circle-exclamation mr-1"></i>Chưa chọn • Đáp án chuẩn: <span class="underline font-mono">${correctLabel}</span></div>`;
                        } else if (isSubCorrect) {
                            resultInfoHTML = `<div class="text-xs font-bold text-emerald-600 dark:text-emerald-400 mt-1"><i class="fa-solid fa-check mr-1"></i>Chính xác • Đáp án chuẩn: <span class="underline font-mono">${correctLabel}</span></div>`;
                        } else {
                            resultInfoHTML = `<div class="text-xs font-bold text-rose-600 dark:text-rose-400 mt-1"><i class="fa-solid fa-xmark mr-1"></i>Sai • Đáp án chuẩn: <span class="underline font-mono">${correctLabel}</span></div>`;
                        }
                    }

                    const kwPill = subItem.answer
                        ? `<span class="kw-pill"><i class="fa-solid fa-key mr-1"></i>Từ khóa Đúng: ${subItem.keyword || ''}</span>`
                        : `<span class="trap-pill"><i class="fa-solid fa-skull-crossbones mr-1"></i>${subItem.keyword || ''}</span>`;

                    const tipBoxHTML = (showTips && subItem.easyExplain) ? `
                        <div class="mt-2 p-2.5 rounded-xl bg-amber-50/90 dark:bg-slate-900/90 border border-amber-300/60 dark:border-slate-700 text-xs space-y-1">
                            <div class="flex flex-wrap items-center gap-2">${kwPill}</div>
                            <div class="text-slate-700 dark:text-slate-300"><strong class="text-amber-700 dark:text-amber-400">Mẹo hiểu nhanh:</strong> ${subItem.easyExplain}</div>
                        </div>
                    ` : '';

                    return `
                        <div class="p-3.5 rounded-xl border ${
                            isSubmitted
                                ? (isSubCorrect ? 'border-emerald-500/40 bg-emerald-50/30 dark:bg-emerald-950/15' : 'border-rose-500/40 bg-rose-50/30 dark:bg-rose-950/15')
                                : (isBoldStatement ? 'border-emerald-500/40 bg-emerald-50/30 dark:bg-emerald-950/15' : 'border-slate-200 dark:border-slate-700/80 bg-slate-50/60 dark:bg-slate-800/40')
                        } flex flex-col gap-2">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                <div class="space-y-1 flex-1">
                                    <div class="text-sm leading-relaxed">
                                        <span class="${labelClass}">${SUB_ITEM_LABELS[sIdx]}</span>
                                        <span class="${statementTextClass}">${subItem.text}</span>
                                    </div>
                                    ${resultInfoHTML}
                                </div>
                                <div class="flex items-center gap-2 shrink-0 self-end sm:self-center">
                                    <button type="button"
                                        ${isSubmitted ? 'disabled' : `onclick="selectPart2Answer(${qIndex}, ${sIdx}, true)"`}
                                        class="px-4 py-2 rounded-xl border text-xs sm:text-sm font-semibold transition min-w-[82px] ${trueBtnClass} ${showBold && subItem.answer ? 'font-extrabold ring-2 ring-emerald-500/40' : ''}">
                                        Đúng
                                    </button>
                                    <button type="button"
                                        ${isSubmitted ? 'disabled' : `onclick="selectPart2Answer(${qIndex}, ${sIdx}, false)"`}
                                        class="px-4 py-2 rounded-xl border text-xs sm:text-sm font-semibold transition min-w-[82px] ${falseBtnClass}">
                                        Sai
                                    </button>
                                </div>
                            </div>
                            ${tipBoxHTML}
                        </div>
                    `;
                }).join('');

                const card = document.createElement('div');
                card.id = `question_p2_${qIndex}`;
                card.className = `scroll-mt-24 rounded-2xl border p-4 sm:p-6 bg-white dark:bg-slate-900 transition ${
                    isSubmitted
                        ? (correctSubCount === 4 ? 'border-emerald-500/50' : 'border-amber-500/50')
                        : 'border-slate-200 dark:border-slate-800'
                }`;

                card.innerHTML = `
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="px-3 py-1 rounded-lg bg-indigo-600 text-white font-mono font-extrabold text-xs sm:text-sm">
                                Câu ${qIndex + 1} (Phần II)
                            </span>
                            ${qObj.isOriginal === false ? `<span class="px-2 py-0.5 rounded bg-amber-500/20 text-amber-700 dark:text-amber-300 text-xs font-extrabold">Đề Sinh Mới</span>` : ''}
                            <span class="text-xs font-medium text-slate-500 dark:text-slate-400 bg-slate-100 dark:bg-slate-800 px-2.5 py-1 rounded-lg">
                                ${qObj.topicName}
                            </span>
                        </div>
                        <div class="flex items-center gap-2">
                            ${scoreBadge}
                            <button type="button" onclick="toggleFlag('p2', ${qIndex})"
                                class="px-2.5 py-1 rounded-lg text-xs font-semibold border transition flex items-center gap-1 ${
                                    isFlagged
                                        ? 'bg-rose-500/15 text-rose-600 dark:text-rose-400 border-rose-500/40'
                                        : 'bg-slate-100 dark:bg-slate-800 text-slate-500 border-slate-200 dark:border-slate-700 hover:text-rose-500'
                                }">
                                <i class="fa-${isFlagged ? 'solid' : 'regular'} fa-flag"></i>
                            </button>
                        </div>
                    </div>

                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800/90 border-l-4 border-indigo-500 text-slate-800 dark:text-slate-200 text-sm leading-relaxed mb-4">
                        ${qObj.passage}
                    </div>

                    <div class="space-y-2.5">
                        ${subRowsHTML}
                    </div>
                `;
                p2List.appendChild(card);
            });
        }

        /**************************************************************************
         * 6. XỬ LÝ CHỌN ĐÁP ÁN, PALETTE & CHẤM ĐIỂM
         **************************************************************************/
        function selectPart1Answer(qIndex, optIndex) {
            if (examState.isSubmitted) return;
            examState.answersP1[qIndex] = optIndex;
            renderAllQuestions();
            renderQuestionPalette();
            updateProgressCounters();
        }

        function selectPart2Answer(qIndex, subIndex, booleanVal) {
            if (examState.isSubmitted) return;
            if (!examState.answersP2[qIndex]) examState.answersP2[qIndex] = {};
            examState.answersP2[qIndex][subIndex] = booleanVal;
            renderAllQuestions();
            renderQuestionPalette();
            updateProgressCounters();
        }

        function toggleFlag(part, qIndex) {
            if (part === 'p1') examState.flaggedP1[qIndex] = !examState.flaggedP1[qIndex];
            else examState.flaggedP2[qIndex] = !examState.flaggedP2[qIndex];
            renderAllQuestions();
            renderQuestionPalette();
        }

        function renderQuestionPalette() {
            const buildP1 = (isMob) => examState.part1Questions.map((qObj, idx) => {
                const answered = examState.answersP1[idx] !== undefined;
                const flagged = !!examState.flaggedP1[idx];
                let color = "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 hover:border-cyan-500";

                if (!examState.isSubmitted) {
                    if (answered) color = "bg-cyan-600 text-white font-extrabold border-cyan-600";
                } else {
                    const correctIdx = qObj.options.findIndex(o => o.isCorrect);
                    color = (examState.answersP1[idx] === correctIdx)
                        ? "bg-emerald-600 text-white font-extrabold border-emerald-600"
                        : "bg-rose-500 text-white font-extrabold border-rose-500";
                }

                const ring = flagged ? "ring-2 ring-rose-500 ring-offset-1 dark:ring-offset-slate-900" : "";
                const letter = answered ? OPTION_LABELS[examState.answersP1[idx]] : '';
                return `<button type="button" onclick="scrollToQuestion('p1', ${idx}, ${isMob})" class="h-9 rounded-lg text-xs font-mono font-bold flex items-center justify-center transition ${color} ${ring}">${idx + 1}${letter ? `<sub class="ml-0.5 text-[10px]">${letter}</sub>` : ''}</button>`;
            }).join('');

            const buildP2 = (isMob) => examState.part2Questions.map((qObj, idx) => {
                const subAns = examState.answersP2[idx] || {};
                const count = Object.keys(subAns).length;
                const flagged = !!examState.flaggedP2[idx];
                let color = "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 hover:border-cyan-500";

                if (!examState.isSubmitted) {
                    if (count === 4) color = "bg-cyan-600 text-white font-extrabold border-cyan-600";
                    else if (count > 0) color = "bg-amber-300 dark:bg-amber-700 text-slate-900 dark:text-white font-bold border-amber-400";
                } else {
                    let c = 0;
                    qObj.items.forEach((s, sIdx) => { if (subAns[sIdx] === s.answer) c++; });
                    if (c === 4) color = "bg-emerald-600 text-white font-extrabold border-emerald-600";
                    else if (c > 0) color = "bg-amber-500 text-slate-950 font-extrabold border-amber-500";
                    else color = "bg-rose-500 text-white font-extrabold border-rose-500";
                }

                const ring = flagged ? "ring-2 ring-rose-500 ring-offset-1 dark:ring-offset-slate-900" : "";
                return `<button type="button" onclick="scrollToQuestion('p2', ${idx}, ${isMob})" class="h-10 rounded-lg text-xs font-mono font-bold flex flex-col items-center justify-center leading-tight transition ${color} ${ring}"><span>C.${idx + 1}</span><span class="text-[10px] opacity-85">${count}/4</span></button>`;
            }).join('');

            document.getElementById('palettePart1Grid').innerHTML = buildP1(false);
            document.getElementById('palettePart2Grid').innerHTML = buildP2(false);
            document.getElementById('mobilePalettePart1Grid').innerHTML = buildP1(true);
            document.getElementById('mobilePalettePart2Grid').innerHTML = buildP2(true);
        }

        function scrollToQuestion(part, index, closeMobile) {
            if (closeMobile) toggleMobilePalette();
            const el = document.getElementById(`question_${part}_${index}`);
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function updateProgressCounters() {
            const total = examState.part1Questions.length + examState.part2Questions.length;
            const doneP1 = Object.keys(examState.answersP1).length;
            let doneP2 = 0;
            examState.part2Questions.forEach((_, idx) => {
                if (examState.answersP2[idx] && Object.keys(examState.answersP2[idx]).length === 4) doneP2++;
            });
            const doneTotal = doneP1 + doneP2;

            document.getElementById('headerProgressText').textContent = `${doneTotal}/${total}`;
            document.getElementById('sidebarProgressBadge').textContent = `${doneTotal}/${total}`;
            document.getElementById('mobileProgressBadge').textContent = `${doneTotal}`;
        }

        function toggleMobilePalette() {
            document.getElementById('mobilePaletteModal').classList.toggle('hidden');
        }

        function toggleCheatSheetModal() {
            document.getElementById('cheatSheetModal').classList.toggle('hidden');
        }

        function startTimer() {
            updateTimerUI();
            examState.timerInterval = setInterval(() => {
                if (examState.isSubmitted) {
                    clearInterval(examState.timerInterval);
                    return;
                }
                examState.remainingSeconds--;
                examState.elapsedSeconds++;
                updateTimerUI();

                if (examState.remainingSeconds <= 0) {
                    clearInterval(examState.timerInterval);
                    gradeExam(true);
                }
            }, 1000);
        }

        function updateTimerUI() {
            const mins = Math.floor(Math.max(0, examState.remainingSeconds) / 60);
            const secs = Math.max(0, examState.remainingSeconds) % 60;
            document.getElementById('timerDisplay').textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
            const containerEl = document.getElementById('timerContainer');
            if (examState.remainingSeconds <= 300 && !examState.isSubmitted) {
                containerEl.classList.add('timer-warning', 'text-rose-400', 'border-rose-500');
            } else {
                containerEl.classList.remove('timer-warning', 'text-rose-400', 'border-rose-500');
            }
        }

        function toggleBinaryTool() {
            document.getElementById('binaryWidget').classList.toggle('hidden');
        }

        function convertBinToDec() {
            const raw = document.getElementById('binInput').value.trim();
            const out = document.getElementById('decOutput');
            if (!raw) {
                out.textContent = '--';
                return;
            }
            const parts = raw.split(/[\s.]+/).filter(Boolean);
            const decParts = [];
            for (const p of parts) {
                if (!/^[01]+$/.test(p)) {
                    out.textContent = 'Chỉ nhập bit 0 hoặc 1';
                    return;
                }
                decParts.push(parseInt(p, 2));
            }
            out.textContent = decParts.join('.');
        }

        function getPart2QuestionScore(correctSubCount) {
            switch (correctSubCount) {
                case 1: return 0.1;
                case 2: return 0.25;
                case 3: return 0.5;
                case 4: return 1.0;
                default: return 0.0;
            }
        }

        function openSubmitModal() {
            if (examState.isSubmitted) return;

            const missingP1 = examState.part1Questions.length - Object.keys(examState.answersP1).length;
            let doneSubP2 = 0;
            examState.part2Questions.forEach((_, idx) => {
                doneSubP2 += Object.keys(examState.answersP2[idx] || {}).length;
            });
            const missingSubP2 = (examState.part2Questions.length * 4) - doneSubP2;

            let msg = `<p class="mb-2">Bạn có chắc chắn muốn nộp bài để xem điểm và toàn bộ <strong>Mẹo Từ Khóa + Giải thích chi tiết</strong>?</p>`;
            if (missingP1 > 0 || missingSubP2 > 0) {
                msg += `
                    <div class="p-3 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-800 dark:text-amber-300 text-xs space-y-1 mt-2">
                        <div class="font-bold"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Cảnh báo câu chưa làm xong:</div>
                        ${missingP1 > 0 ? `<div>• Phần I còn <strong>${missingP1} câu</strong> chưa chọn đáp án.</div>` : ''}
                        ${missingSubP2 > 0 ? `<div>• Phần II còn <strong>${missingSubP2} ý (Đúng/Sai)</strong> chưa chọn.</div>` : ''}
                    </div>
                `;
            } else {
                msg += `<div class="text-xs font-bold text-emerald-600 dark:text-emerald-400"><i class="fa-solid fa-circle-check mr-1"></i>Bạn đã hoàn thành 100% tất cả các câu hỏi!</div>`;
            }

            showCustomModal({
                title: "Xác nhận nộp bài Tin học 12",
                subtitle: `Mã đề: ${examState.examCode}`,
                bodyHTML: msg,
                confirmText: "Nộp bài & Xem giải thích",
                onConfirm: () => {
                    closeCustomModal();
                    gradeExam(false);
                }
            });
        }

        function gradeExam(isAutoTimeout) {
            if (examState.timerInterval) clearInterval(examState.timerInterval);
            examState.isSubmitted = true;

            let correctP1 = 0;
            examState.part1Questions.forEach((qObj, idx) => {
                const correctIdx = qObj.options.findIndex(o => o.isCorrect);
                if (examState.answersP1[idx] === correctIdx) correctP1++;
            });
            const scoreP1 = correctP1 * 0.25;
            const maxP1 = examState.part1Questions.length * 0.25;

            let scoreP2 = 0;
            let totalCorrectSubs = 0;
            const subStats = { 0: 0, 1: 0, 2: 0, 3: 0, 4: 0 };

            examState.part2Questions.forEach((qObj, idx) => {
                const subAns = examState.answersP2[idx] || {};
                let c = 0;
                qObj.items.forEach((s, sIdx) => {
                    if (subAns[sIdx] === s.answer) {
                        c++;
                        totalCorrectSubs++;
                    }
                });
                subStats[c]++;
                scoreP2 += getPart2QuestionScore(c);
            });
            const maxP2 = examState.part2Questions.length * 1.0;

            const totalRaw = scoreP1 + scoreP2;
            const totalMax = maxP1 + maxP2;
            const scaled10 = totalMax > 0 ? (totalRaw / totalMax) * 10 : 0;

            document.getElementById('resultSummaryPanel').classList.remove('hidden');
            document.getElementById('headerSubmitBtn').classList.add('hidden');
            document.getElementById('sidebarSubmitBtn').classList.add('hidden');

            const mins = Math.floor(examState.elapsedSeconds / 60);
            const secs = examState.elapsedSeconds % 60;
            document.getElementById('resultTitleText').textContent = isAutoTimeout
                ? "Hết giờ! Hệ thống đã tự động chấm điểm."
                : "Hoàn thành bài kiểm tra Tin học 12!";
            document.getElementById('resultTimeSpentText').textContent = `Mã đề: ${examState.examCode} • Thời gian làm: ${mins} phút ${secs} giây`;

            document.getElementById('finalScore10Display').textContent = scaled10.toFixed(2).replace('.', ',');
            document.getElementById('part1ScoreDisplay').textContent = `${scoreP1.toFixed(2).replace('.', ',')} / ${maxP1.toFixed(2).replace('.', ',')}đ`;
            document.getElementById('part1CorrectCountDisplay').textContent = `Đúng ${correctP1}/${examState.part1Questions.length} câu`;

            document.getElementById('part2ScoreDisplay').textContent = `${scoreP2.toFixed(2).replace('.', ',')} / ${maxP2.toFixed(2).replace('.', ',')}đ`;
            document.getElementById('part2SubCountDisplay').textContent = `Đúng ${totalCorrectSubs}/${examState.part2Questions.length * 4} ý a, b, c, d`;

            document.getElementById('stat4Sub').textContent = `${subStats[4]} câu`;
            document.getElementById('stat3Sub').textContent = `${subStats[3]} câu`;
            document.getElementById('stat2Sub').textContent = `${subStats[2]} câu`;
            document.getElementById('stat1Sub').textContent = `${subStats[1]} câu`;

            renderAllQuestions();
            renderQuestionPalette();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function setReviewFilter(filterType) {
            examState.reviewFilter = filterType;
            const activeClass = "px-3 py-1.5 rounded-xl text-xs font-bold bg-cyan-600 text-white";
            const inactiveClass = "px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700";

            document.getElementById('filterBtnAll').className = filterType === 'all' ? activeClass : inactiveClass;
            document.getElementById('filterBtnWrong').className = filterType === 'wrong' ? activeClass : inactiveClass;
            document.getElementById('filterBtnFlagged').className = filterType === 'flagged' ? activeClass : inactiveClass;
            renderAllQuestions();
        }

        function showCustomModal({ title, subtitle, bodyHTML, confirmText, onConfirm }) {
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalSubtitle').textContent = subtitle || '';
            document.getElementById('modalBody').innerHTML = bodyHTML;
            const btn = document.getElementById('modalConfirmBtn');
            btn.textContent = confirmText || 'Đồng ý';
            btn.onclick = onConfirm;
            document.getElementById('customModal').classList.remove('hidden');
        }

        function closeCustomModal() {
            document.getElementById('customModal').classList.add('hidden');
        }

        function confirmReshuffle() {
            if (examState.isSubmitted) {
                reshuffleAndRestart();
                return;
            }
            showCustomModal({
                title: "Đảo đề Tin học mới?",
                subtitle: "Trộn lại thứ tự câu hỏi và sinh câu Đúng/Sai mới",
                bodyHTML: "Bài đang làm hiện tại sẽ được tạo mới với thứ tự câu hỏi và phương án trả lời khác. Bạn có muốn đổi đề ngay không?",
                confirmText: "Đảo đề mới",
                onConfirm: () => {
                    closeCustomModal();
                    reshuffleAndRestart();
                }
            });
        }

        function reshuffleAndRestart() {
            startExam();
        }

        function confirmExitToSetup() {
            if (!examState.isActive || examState.isSubmitted) {
                exitToSetup();
                return;
            }
            showCustomModal({
                title: "Quay lại màn hình chính?",
                subtitle: "Tiến độ bài đang làm sẽ bị hủy",
                bodyHTML: "Nếu bạn quay về màn hình chính lúc này, các đáp án đang chọn trong bài thi sẽ không được lưu. Bạn có chắc chắn muốn thoát?",
                confirmText: "Về trang chính",
                onConfirm: () => {
                    closeCustomModal();
                    exitToSetup();
                }
            });
        }

        function exitToSetup() {
            if (examState.timerInterval) clearInterval(examState.timerInterval);
            examState.isActive = false;
            document.getElementById('examWorkspace').classList.add('hidden');
            document.getElementById('infiniteTrainerScreen').classList.add('hidden');
            document.getElementById('examHeaderControls').classList.add('hidden');
            document.getElementById('examHeaderControls').classList.remove('flex');
            document.getElementById('backToConfigBtn').classList.add('hidden');
            document.getElementById('setupScreen').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleDarkMode() {
            const htmlEl = document.documentElement;
            const icon = document.getElementById('themeIcon');
            htmlEl.classList.toggle('dark');
            icon.className = htmlEl.classList.contains('dark') ? "fa-solid fa-sun" : "fa-solid fa-moon";
        }
    </script>
</body>
