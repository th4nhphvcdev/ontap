                                    <i class="fa-solid ${isSubCorrect ? 'fa-circle-check' : 'fa-circle-xmark'} mr-1"></i>
                                    ${isSubCorrect ? 'CHÍNH XÁC!' : 'BỊ LỪA RỒI!'} Đáp án chuẩn là: <span class="underline font-mono">${sub.answer ? 'ĐÚNG' : 'SAI'}</span>
                                </div>
                            ` : ''}

