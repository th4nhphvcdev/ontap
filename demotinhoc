            document.getElementById('examWorkspace').classList.add('hidden');
            document.getElementById('examHeaderControls').classList.add('hidden');
            document.getElementById('examHeaderControls').classList.remove('flex');
            document.getElementById('backToConfigBtn').classList.remove('hidden');
            document.getElementById('backToConfigBtn').classList.add('flex');
            document.getElementById('infiniteTrainerScreen').classList.remove('hidden');

            renderInfiniteTrainerCards();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function setTrainerMode(mode) {
            trainerFilterMode = mode;
            const activeClass = "px-3 py-1.5 rounded-lg bg-cyan-500 text-slate-950 font-extrabold";
            const inactiveClass = "px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold";
            document.getElementById('trBtnAll').className = mode === 'all' ? activeClass : inactiveClass;
            document.getElementById('trBtnOrig').className = mode === 'original' ? activeClass : inactiveClass;
            document.getElementById('trBtnInf').className = mode === 'infinite' ? activeClass : inactiveClass;
            renderInfiniteTrainerCards();
        }

        function generateMoreInfiniteTF(count = 5) {
            const newBatch = [];
            for (let i = 0; i < count; i++) {
                newBatch.push(generateSingleInfiniteTFQuestion(['NET', 'AI', 'ETHICS']));
            }
            trainerQuestions = [...newBatch, ...trainerQuestions];
            if (trainerFilterMode === 'original') trainerFilterMode = 'all';
            setTrainerMode(trainerFilterMode);
        }

        function shuffleTrainerList() {
            trainerQuestions = shuffleArray(trainerQuestions).map(q => ({
                ...q,
                items: shuffleArray(q.items)
            }));
            trainerAnswers = {};
            renderInfiniteTrainerCards();
        }

        function selectTrainerSubAnswer(qId, sIdx, val) {
            if (!trainerAnswers[qId]) trainerAnswers[qId] = {};
            trainerAnswers[qId][sIdx] = val;
            renderInfiniteTrainerCards();
