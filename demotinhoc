            const originals = CS_QUESTION_BANK.part2.map(q => ({
                ...q,
                items: q.items.map(it => ({ ...it }))
            }));
            const initialInfinites = [];
            for (let i = 0; i < 4; i++) {
                initialInfinites.push(generateSingleInfiniteTFQuestion(['NET']));
            }
            trainerQuestions = [...originals, ...initialInfinites];
        }

        function openInfiniteTFTrainer() {
            if (examState.timerInterval) clearInterval(examState.timerInterval);
            if (trainerQuestions.length === 0) initTrainerPool();

