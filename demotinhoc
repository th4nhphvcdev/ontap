                { id: "P1_08", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Sự kết hợp IoT và AI (AIoT) giúp ích cho các nhà khoa học như thế nào?", correct: "Giúp giám sát môi trường tự nhiên và theo dõi tình hình biến đổi khí hậu.", distractors: ["Hỗ trợ quyết định đầu tư, phát hiện và ngăn chặn gian lận, nâng cao trải nghiệm khách hàng trong lĩnh vực tài chính, ngân hàng.", "Cải thiện hiệu suất, hiệu quả của các lĩnh vực sản xuất.", "Phát triển các nền tảng học trực tuyến thông minh."] },
                { id: "P1_09", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Trong lĩnh vực sản xuất công nghiệp, robot AI được sử dụng để thực hiện các công việc lặp đi lặp lại hoặc nguy hiểm. Lợi ích chính của việc sử dụng robot AI trong sản xuất là gì?", correct: "Tăng năng suất, giảm thiểu sai sót, và cải thiện điều kiện làm việc an toàn hơn.", distractors: ["Giảm chi phí đầu tư ban đầu vào máy móc và thiết bị.", "Tạo ra nhiều việc làm mới cho công nhân lành nghề.", "Đơn giản hóa quy trình quản lý và vận hành nhà máy."] },
                { id: "P1_10", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Phương án nào sau đây nêu ĐÚNG về khả năng học của AI?", correct: "Nắm bắt thông tin từ dữ liệu và điều chỉnh hành vi dựa trên thông tin mới.", distractors: ["Vận dụng logic và tri thức để đưa ra quyết định hoặc kết luận.", "Cảm nhận và hiểu biết môi trường thông qua các cảm biến và dữ liệu đầu vào.", "Tìm ra cách giải quyết các tình huống phức tạp dựa trên thông tin và tri thức."] },
                { id: "P1_11", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Phương án nào sau đây nêu ĐÚNG về khả năng nhận thức của AI?", correct: "Cảm nhận và hiểu biết môi trường thông qua các cảm biến và dữ liệu đầu vào.", distractors: ["Nắm bắt thông tin từ dữ liệu và điều chỉnh hành vi dựa trên thông tin mới.", "Vận dụng logic và tri thức để đưa ra quyết định hoặc kết luận.", "Tìm ra cách giải quyết các tình huống phức tạp dựa trên thông tin và tri thức."] },
                { id: "P1_12", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Phát biểu nào sau đây là SAI khi nói về AI (trí tuệ nhân tạo)?", correct: "Thông tin phản hồi luôn chính xác.", distractors: ["Được ứng dụng trên nhiều lĩnh vực.", "Thay thế một số nghề trong tương lai.", "Dễ bị lạm dụng vào mục đích xấu."] },
                { id: "P1_13", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Hệ chuyên gia MYCIN là hệ chuyên gia thuộc lĩnh vực:", correct: "Y học.", distractors: ["Viễn thông.", "Sản xuất.", "Giáo dục."] },
                { id: "P1_14", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Các máy tính tìm kiếm thông tin trên Internet như Google, Bing có thể hiểu yêu cầu tra cứu của người dùng được đưa vào bằng văn bản hay bằng tiếng nói. Đây là một trong những đặc trưng cơ bản của AI có khả năng?", correct: "Hiểu ngôn ngữ.", distractors: ["Suy luận.", "Nhận thức.", "Giải quyết vấn đề."] },
                { id: "P1_15", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Nhận dạng khuôn mặt KHÔNG thể hiện được ứng dụng trong những lĩnh vực nào sau đây?", correct: "Chẩn đoán chính xác bệnh tật dựa trên sắc diện gương mặt bệnh nhân.", distractors: ["An ninh, xã hội.", "Xác định danh tính.", "Theo dõi khách hàng trong kinh doanh."] },
                { id: "P1_16", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Hệ thống nào sau đây là ví dụ về khả năng suy luận của AI?", correct: "Hệ thống chẩn đoán y tế.", distractors: ["Hệ thống khuyến nghị YouTube.", "Máy tính điều khiển xe tự lái.", "Công cụ tìm kiếm Google."] },
                { id: "P1_17", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Hệ thống AI nào sau đây có thể hiểu ngôn ngữ tự nhiên?", correct: "Trợ lí ảo Siri.", distractors: ["Phần mềm chơi cờ AlphaGo.", "Robot hút bụi.", "Xe tự lái."] },
                { id: "P1_18", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Ứng dụng nào sau đây KHÔNG là ví dụ của AI hẹp?", correct: "Quản lí điểm của học sinh bằng số điểm điện tử.", distractors: ["Chương trình chơi cờ AlphaGo.", "Máy chấm công bằng nhận diện khuôn mặt.", "Hệ chuyên gia MYCIN tư vấn trong lĩnh vực y tế."] },
                { id: "P1_19", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Trong lĩnh vực y tế, thành tựu nào sau đây dựa trên sự phát triển của AI?", correct: "Phần mềm hỗ trợ phân tích hình ảnh X-quang để phát hiện bất thường.", distractors: ["Đặt lịch khám với chuyên gia bằng sử dụng ứng dụng của bệnh viện trên điện thoại di động.", "Tra cứu hồ sơ điện tử của bệnh nhân bằng số căn cước công dân.", "Thanh toán viện phí bằng hình thức chuyển khoản."] },
                { id: "P1_20", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Một số hệ thống được tích hợp AI, ví dụ: (1) Trợ lí ảo trên điện thoại; (2) Đề xuất nghe nhạc trực tuyến; (3) Phân loại loài thực vật; (4) Kiểm duyệt nội dung bình luận; (5) Kiểm duyệt nội dung trong video; (6) Hệ chuyên gia y tế MYCIN. Khả năng hiểu ngôn ngữ được thể hiện trong các hệ thống nào sau đây?", correct: "1, 4, 5.", distractactors_fix: true, distractors: ["1, 2, 4.", "3, 4, 5.", "1, 3, 6."] },
                { id: "P1_21", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Thiết bị nào sau đây được xem là một ứng dụng của AI?", correct: "Máy nghe nhạc có thể tự tạo danh sách bài hát dựa trên lịch sử nghe nhạc.", distractors: ["Máy ghi âm có thể lọc bỏ tạp âm, xuất âm thanh dưới nhiều định dạng.", "Máy hút bụi có thể tự di chuyển, tự hoạt động theo thời gian đã thiết lập.", "Máy điều hòa có khả năng tự điều chỉnh nhiệt độ dựa vào nhiệt độ thực tế."] },
                { id: "P1_22", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Robot tự hành, như xe tự lái hoặc robot hút bụi thông minh, chủ yếu dựa vào khả năng nào của AI để có thể nhận biết và tương tác với môi trường xung quanh?", correct: "Khả năng nhận thức.", distractors: ["Khả năng lập kế hoạch.", "Khả năng học.", "Khả năng hiểu ngôn ngữ."] },
                { id: "P1_23", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Một hệ thống đề xuất sản phẩm trực tuyến (ví dụ: gợi ý phim trên Netflix, sản phẩm trên Amazon) hoạt động dựa trên khả năng nào của AI?", correct: "Khả năng học.", distractors: ["Khả năng hiểu ngôn ngữ tự nhiên.", "Khả năng nhận thức.", "Khả năng giải quyết vấn đề."] },
                { id: "P1_24", topic: "AI", topicName: "Chủ đề A: Trí tuệ nhân tạo (AI)", q: "Trong các ứng dụng sau, ứng dụng nào thể hiện khả năng “hiểu ngôn ngữ tự nhiên” của AI?", correct: "Công cụ dịch thuật trực tuyến như Google Dịch.", distractors: ["Hệ thống nhận dạng khuôn mặt.", "Phần mềm diệt virus tự động cập nhật.", "Robot phẫu thuật được điều khiển từ xa."] },
                { id: "P1_25", topic: "NET", topicName: "Chủ đề B: Mạng máy tính & Internet", q: "Thiết bị nào sau đây có chức năng cung cấp kết nối không dây cho các thành phần trong một mạng?", correct: "Access Point.", distractors: ["Hub.", "Switch.", "Router."] },
                { id: "P1_26", topic: "NET", topicName: "Chủ đề B: Mạng máy tính & Internet", q: "Chức năng chính của Access Point là gì?", correct: "Mở rộng vùng phủ sóng Wi-fi cho mạng LAN.", distractors: ["Chia sẻ file và thư mục giữa các máy tính trong mạng.", "Kết nối các thiết bị mạng với nhau.", "Cung cấp dịch vụ DHCP để cấp địa chỉ IP cho các thiết bị."] },
                { id: "P1_27", topic: "NET", topicName: "Chủ đề B: Mạng máy tính & Internet", q: "Giao thức mạng là gì?", correct: "Tập hợp các quy tắc và quy định về cách thức giao tiếp để truyền dữ liệu giữa các thiết bị trong mạng.", distractors: ["Phần mềm giúp máy tính kết nối với Internet.", "Loại cáp mạng được sử dụng để kết nối các thiết bị trong mạng.", "Thiết bị được sử dụng để kết nối các thiết bị trong mạng."] },
                { id: "P1_28", topic: "NET", topicName: "Chủ đề B: Mạng máy tính & Internet", q: "Thiết bị nào sau đây được sử dụng để kết nối các mạng LAN với nhau?", correct: "Router.", distractors: ["Firewall.", "Switch.", "Access Point."] },
                { id: "P1_29", topic: "NET", topicName: "Chủ đề B: Mạng máy tính & Internet", q: "Nếu bạn chỉ cần một thiết bị để kết nối Internet cho một máy tính duy nhất, thiết bị nào là lựa chọn đơn giản và hiệu quả nhất?", correct: "Modem.", distractors: ["Hub.", "Switch.", "Wireless Access Point."] },
                { id: "P1_30", topic: "NET", topicName: "Chủ đề B: Mạng máy tính & Internet", q: "Phát biểu nào sau đây là SAI khi nói về mạng máy tính?", correct: "Mạng máy tính không bao gồm các thiết bị phần cứng.", distractors: ["Mạng máy tính là một tập hợp các thiết bị điện tử được kết nối với nhau để truyền thông tin.", "Mạng máy tính bao gồm các loại mạng như LAN (Local Area Network) và WAN (Wide Area Network).", "Mạng máy tính sử dụng các giao thức như TCP/IP để truyền dữ liệu giữa các thiết bị trong mạng."] },
                { id: "P1_31", topic: "NET", topicName: "Chủ đề B: Mạng máy tính & Internet", q: "Phát biểu nào sau đây là SAI về mạng LAN?", correct: "Mạng LAN không thể kết nối được với Internet.", distractors: ["Mạng LAN (Local Area Network) là một mạng máy tính mà các thiết bị kết nối với nhau trong phạm vi hạn chế như một văn phòng, một toà nhà hoặc một căn hộ.", "Mạng LAN có thể sử dụng kĩ thuật truyền dẫn dây cáp để kết nối.", "Mạng LAN có thể bao gồm các dịch vụ như chia sẻ tập tin, máy in và kết nối Internet chung."] },
                { id: "P1_32", topic: "NET", topicName: "Chủ đề B: Mạng máy tính & Internet", q: "Phát biểu nào sau đây là KHÔNG đúng khi chia sẻ tệp trên mạng LAN?", correct: "Chia sẻ tệp trên mạng LAN không bao gồm việc sử dụng mật khẩu hoặc quản lí truy cập vào các tệp đã được chia sẻ.", distractors: ["Chia sẻ tệp trên mạng LAN cho phép nhiều người dùng trong mạng truy cập và sử dụng các tệp từ các máy tính khác nhau trong mạng.", "Chia sẻ tệp trên mạng LAN thường được thực hiện thông qua việc thiết lập quyền truy cập cho các tệp và thư mục.", "Việc chia sẻ tệp trên mạng LAN không đòi hỏi sử dụng phần mềm đặc biệt, hệ điều hành máy tính có thể cung cấp các tính năng chia sẻ tệp tích hợp."] },
                { id: "P1_33", topic: "NET", topicName: "Chủ đề B: Mạng máy tính & Internet", q: "Trong một phòng máy tính của trường học, bạn cần kết nối máy tính của mình với switch để có thể truy cập Internet và chia sẻ tài nguyên. Bạn sẽ sử dụng loại dây nào sau đây để thực hiện kết nối này?", correct: "Dây cáp mạng Ethernet.", distractors: ["Dây cáp quang.", "Dây cáp HDMI.", "Dây cáp USB."] },
                { id: "P1_34", topic: "NET", topicName: "Chủ đề B: Mạng máy tính & Internet", q: "Em cùng gia đình đi du lịch. Tại đó, em cần kết nối điện thoại thông minh (chạy hệ điều hành Android) của mình với Access Point của khách sạn để có thể truy cập được vào mạng Internet. Quy trình nào sau đây em cần làm để thực hiện công việc trên?", correct: "Bật chức năng Wi-fi trên điện thoại → Tìm và chọn mạng Wi-fi tương ứng với Access Point → Nhập mật khẩu (nếu có) → Nhấn chọn Kết nối.", distractors: ["Bật Bluetooth trên điện thoại → Tìm và chọn thiết bị → Nhập mã PIN (nếu có) → Nhấn chọn Kết nối.", "Bật NFC → Đặt điện thoại gần với thiết bị → Xác nhận việc kết nối và chờ kết nối.", "Bật 3G/4G trên điện thoại → Tìm và chọn mạng di động → Nhập mật khẩu (nếu có) → Kích hoạt dịch vụ."] },
                { id: "P1_35", topic: "NET", topicName: "Chủ đề B: Mạng máy tính & Internet", q: "Hệ thống thiết bị nào dưới đây là mạng máy tính?", correct: "Hai máy tính cá nhân của một người dùng, một chiếc ở cơ quan, chiếc còn lại ở nhà riêng của người đó. Hai máy tính đó được kết nối với nhau để truyền dữ liệu.", distractors: ["Các chiếc loa của một trường học, được gắn ở sân trường và được kết với chiếc micro đặt ở phòng giám hiệu. Khi giáo viên thông báo vào micro, học sinh ở sân trường đều nghe được.", "Các thiết bị điện gia dụng trong một toà nhà, bao gồm: máy tính cá nhân, máy tính để bàn, bếp từ, lò vi sóng và các đèn điện.", "Các máy tính của một cơ quan trong đó dữ liệu được truyền từ máy này sang máy khác bằng cách sao chép qua thiết bị nhớ Flash (USB)."] },
                { id: "P1_36", topic: "NET", topicName: "Chủ đề B: Mạng máy tính & Internet", q: "Các máy trạm trong mạng thường kết nối với Switch bằng thiết bị hay phương tiện nào sau đây?", correct: "Cáp xoắn với đầu giắc cắm RJ-45.", distractors: ["Sóng Wi-Fi.", "Sóng điện tử.", "Cáp quang."] },
                { id: "P1_37", topic: "NET", topicName: "Chủ đề B: Mạng máy tính & Internet", q: "Địa chỉ IP: <code class='px-2 py-0.5 rounded bg-slate-200 dark:bg-slate-800 font-mono text-cyan-700 dark:text-cyan-300'>11000000 10101000 11111111 00000111</code> dưới dạng thập phân là?", correct: "192.168.255.7.", distractors: ["193.168.255.7.", "192.168.252.7.", "192.168.255.5."] },
                { id: "P1_38", topic: "ETHICS", topicName: "Chủ đề F: Văn hóa & Ứng xử số", q: "Không gian mạng được định nghĩa chủ yếu dựa trên yếu tố nào sau đây?", correct: "Hệ thống các mạng máy tính kết nối toàn cầu.", distractors: ["Các mối quan hệ xã hội hình thành trực tuyến.", "Văn hóa và phong tục tập quán trên Internet.", "Luật pháp và quy định quản lý hoạt động trực tuyến."] },
                { id: "P1_39", topic: "ETHICS", topicName: "Chủ đề F: Văn hóa & Ứng xử số", q: "Ưu điểm nổi bật nhất của giao tiếp trong không gian mạng so với giao tiếp truyền thống là gì?", correct: "Mở rộng phạm vi và vượt qua rào cản địa lý.", distractors: ["Đảm bảo sự chân thực và tin cậy tuyệt đối.", "Tăng cường khả năng biểu đạt cảm xúc cá nhân.", "Giảm thiểu nguy cơ hiểu lầm do khác biệt ngôn ngữ."] },
